# Copy this file to .env and fill in your CRM. .env is gitignored.
# On-prem, Windows auth as the logged-in user:
CRM_CONNECTION_STRING="AuthType=AD;Url=http://crmserver/OrgName"
# Or as a specific domain user:
# CRM_CONNECTION_STRING="AuthType=AD;Url=http://crmserver/OrgName;Domain=CONTOSO;Username=svc-crm;Password=..."
